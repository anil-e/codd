<component type="desktop-application">
  <id>io.github.anil_e.Codd</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Codd</name>
  <summary>Lightweight PostgreSQL client</summary>
  <description>
    <p>
      Codd is a lightweight PostgreSQL query app for GNOME built with Rust,
      GTK4, and libadwaita.
    </p>
    <p>
      It focuses on saved connections, database browsing, SQL execution, and
      native result previews without trying to become a multi-database suite.
    </p>
  </description>
  <launchable type="desktop-id">io.github.anil_e.Codd.desktop</launchable>
  <url type="homepage">https://github.com/anil-e/codd</url>
  <url type="vcs-browser">https://github.com/anil-e/codd</url>
  <url type="bugtracker">https://github.com/anil-e/codd/issues</url>
  <url type="translate">https://hosted.weblate.org/engage/codd/</url>
  <developer id="io.github.anil_e">
    <name>Anil Erdogan</name>
  </developer>
  <provides>
    <binary>codd</binary>
  </provides>
  <branding>
    <color type="primary" scheme_preference="light">#E0943F</color>
    <color type="primary" scheme_preference="dark">#6B4C29</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-query.png</image>
      <caption>Run SQL queries with syntax highlighting and result previews</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-table-browser.png</image>
      <caption>Browse PostgreSQL table data with pagination and filters</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-insert-row.png</image>
      <caption>Insert new table rows with defaults, NULL values and PostgreSQL type validation</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-structure-columns.png</image>
      <caption>Inspect table columns, data types, nullability, defaults and primary keys</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-structure-constraints-keys-triggers.png</image>
      <caption>Review indexes, constraints, foreign keys and triggers in the structure view</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-drop-constraint.png</image>
      <caption>Edit table structure from native context menus</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-truncate.png</image>
      <caption>Use table actions like rename, truncate and delete</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/anil-e/codd/v0.11.1/images/flathub/screenshot-start.png</image>
      <caption>Manage saved PostgreSQL connections</caption>
    </screenshot>
  </screenshots>
  <translation type="gettext">codd</translation>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.11.1" date="2026-06-24">
      <description translate="no">
        <p>This maintenance release updates translations.</p>

        <ul>
          <li>Finnish, Portuguese (Brazil) and Tamil translations are now included in builds.</li>
          <li>Portuguese (Brazil) and Tamil translations were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.11.0" date="2026-06-20">
      <description translate="no">
        <p>This release adds row deletion from the table browser and improves error handling.</p>

        <ul>
          <li>Table rows can now be deleted from the table browser using the toolbar, context menu or Delete key.</li>
          <li>Query error messages are now selectable and copyable.</li>
          <li>The table browser context menu was refined with clearer action groups.</li>
          <li>Spanish and French translations were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.10.0" date="2026-06-15">
      <description translate="no">
        <p>This release adds manual refresh actions and improves the workspace sidebar on medium-sized windows.</p>

        <ul>
          <li>Database objects can now be refreshed manually from the sidebar or with F5.</li>
          <li>The database switcher now has a refresh action for newly created databases.</li>
          <li>The workspace sidebar now uses less width on medium-sized windows.</li>
          <li>Translations and screenshots were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.9.1" date="2026-06-13">
      <description translate="no">
        <p>This maintenance release fixes the insert row dialog layout in Flatpak builds.</p>

        <ul>
          <li>The insert row dialog is now wider and avoids horizontal scrolling inside the row list.</li>
        </ul>
      </description>
    </release>
    <release version="0.9.0" date="2026-06-13">
      <description translate="no">
        <p>This release adds row insertion from the table browser and refines the object sidebar.</p>

        <ul>
          <li>Tables can now insert new rows from the table browser, with support for DEFAULT values, NULL values and PostgreSQL type validation.</li>
          <li>The table browser toolbar now uses compact icon actions for insert, filters, export and refresh.</li>
          <li>The object sidebar was redesigned to be more compact, responsive and consistent with GNOME navigation patterns.</li>
          <li>Table browser screenshots were refreshed for Flathub.</li>
          <li>Translations were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.8.1" date="2026-06-07">
      <description translate="no">
        <p>This maintenance release updates translations.</p>

        <ul>
          <li>German and Spanish translations were refreshed.</li>
        </ul>
      </description>
    </release>
    <release version="0.8.0" date="2026-06-06">
      <description translate="no">
        <p>This release adds structure actions for table columns, indexes, constraints, foreign keys and triggers.</p>

        <ul>
          <li>Structure view items now include context menu actions to copy names, rename items and drop items.</li>
          <li>Drop actions run without CASCADE first and only offer CASCADE after PostgreSQL reports dependent objects.</li>
          <li>More Keyboard shortcuts were added (closing tabs and cancelling running queries).</li>
          <li>An About dialog and German translations were added.</li>
        </ul>
      </description>
    </release>
    <release version="0.7.1" date="2026-06-04">
      <description translate="no">
        <p>This maintenance release updates the Spanish translation.</p>

        <ul>
          <li>Spanish translations were refreshed, thanks to Francisco V. &lt;fvasquez@fvtronics.com&gt;.</li>
        </ul>
      </description>
    </release>
    <release version="0.7.0" date="2026-06-04">
      <description translate="no">
        <p>This release adds CSV export and copy actions for query results and table browser data.</p>

        <ul>
          <li>Query results can now be exported as CSV with a configurable row limit.</li>
          <li>Table browser exports now respect the current filters and sorting.</li>
          <li>Query result and table browser cells now include copy actions in their context menus.</li>
          <li>The workspace sidebar now uses an adaptive overlay layout for better narrow-window behavior.</li>
        </ul>
      </description>
    </release>
    <release version="0.6.1" date="2026-06-01">
      <description translate="no">
        <p>This maintenance release improves tab restoration and fixes PostgreSQL value decoding issues.</p>

        <ul>
          <li>Workspace tabs are now restored per connection and database, with lazy loading for restored table tabs.</li>
          <li>Table filters can now be applied with Enter from text fields.</li>
          <li>Several PostgreSQL value decoding bugs were fixed.</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-05-29">
      <description translate="no">
        <p>This release adds multi-window support and safer handling for large query results.</p>

        <ul>
          <li>Multiple windows can now be opened, each with its own connection, sidebar, query tabs and table tabs.</li>
          <li>Query results now use a configurable row limit to avoid loading unbounded result sets into memory.</li>
          <li>Opening an already open table from the sidebar now refreshes the existing tab.</li>
          <li>The New Connection action is now kept on the start screen, while workspace windows focus on the active connection.</li>
          <li>Empty query results now show a clear status page instead of an empty grid.</li>
        </ul>
      </description>
    </release>
    <release version="0.5.2" date="2026-05-24">
      <description translate="no">
        <p>This release updates the Spanish translation.</p>

        <ul>
          <li>Spanish translations were refreshed for the latest interface changes, thanks to Francisco V. &lt;fvasquez@fvtronics.com&gt;.</li>
        </ul>
      </description>
    </release>
    <release version="0.5.1" date="2026-05-22">
      <description translate="no">
        <p>This release contains visual refinements for 0.5.</p>

        <ul>
          <li>The new query action now uses a compact tab icon without label in the header bar.</li>
          <li>Database and connection states use a bundled GNOME symbolic server icon for more consistent styling.</li>
          <li>Flathub branding colors were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-05-22">
      <description translate="no">
        <p>This release adds table structure inspection, table script generation and a more consistent GNOME icon set.</p>

        <ul>
          <li>Tables now have a Structure view with columns, data types, defaults, primary keys, indexes, constraints, foreign keys and triggers.</li>
          <li>The table sidebar context menu can generate CREATE, SELECT, INSERT, UPDATE and DELETE scripts in a new query tab.</li>
          <li>The object sidebar refreshes after queries that can change the database schema.</li>
          <li>Application icons are now bundled as GNOME symbolic resources for a consistent appearance across Flatpak and local builds.</li>
          <li>The table browser internals were refactored for simpler, more maintainable code.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-05-17">
      <description translate="no">
        <p>This release adds secure password storage, Spanish translations and more complete table actions.</p>

        <ul>
          <li>Passwords can now be saved securely in Keyring.</li>
          <li>Table truncation now supports RESTART IDENTITY and CASCADE options.</li>
          <li>Table browser internals were split into smaller modules for better maintainability.</li>
          <li>Spanish translations were added, thanks to Francisco V. &lt;fvasquez@fvtronics.com&gt;.</li>
          <li>Screenshots and branding colors were refreshed for Flathub.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-05-14">
      <description translate="no">
        <p>This release improves SQL execution, table browsing, and application branding.</p>

        <ul>
          <li>When part of a query is selected, only that selected SQL can now be executed.</li>
          <li>Table browser columns can be sorted from the column header.</li>
          <li>First and last page navigation was added to the table browser.</li>
          <li>Table and view names can now be copied from the object sidebar context menu.</li>
          <li>PostgreSQL SQL parsing was improved for quoted strings and other edge cases.</li>
          <li>The application icon, screenshots, and branding metadata were updated.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-05-12">
      <description translate="no">
        <p>Add connection-wide database switching from the title bar, with query history scoped per database and migrated automatically.</p>
        <p>Add table and view context actions for renaming, truncating tables, and deleting database objects.</p>
        <p>Add custom SQL filters to the table browser.</p>
        <p>Fix slow table rendering for large cell values, thanks to Christian Kruse &lt;cjk@defunct.ch&gt;.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-05-10">
      <description translate="no">
        <p>Maintenance release with CI, packaging metadata improvements, and stable Rust check fixes.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-09">
      <description translate="no">
        <p>Initial release with saved PostgreSQL connections, SQL execution, query history, schema browsing, table browsing, filtering, and editable table cells.</p>
      </description>
    </release>
  </releases>
</component>
